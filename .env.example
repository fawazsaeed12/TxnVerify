# TxnVerify AI - Environment Configuration

# Google AI Studio / Gemini API Key (Required for Gemma 4 visual OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it

# Google OAuth 2.0 Credentials (for Gmail API read-only access)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8501

# Port Configurations
FASTAPI_PORT=8000
WHATSAPP_PORT=3001
STREAMLIT_PORT=8501

# Gateway Inter-communication URLs
WHATSAPP_GATEWAY_URL=http://localhost:3001
PYTHON_WEBHOOK_URL=http://127.0.0.1:8000/webhook/whatsapp
